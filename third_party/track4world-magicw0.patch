+    b_values = torch.where(valid, b.float().reshape(b.shape[0], -1), 0.0)
+    numerator = (a_values * b_values).sum(dim=1)
+    denominator = b_values.square().sum(dim=1).clamp_min(float(eps))
+    return numerator / denominator
 
 

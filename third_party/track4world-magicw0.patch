+def _resolve_depthanything3_model_path(
+    model_path: str,
+    local_files_only: bool,
+) -> str:
+    """Return a local ``from_pretrained`` directory for DA3 when running offline."""
+    if not local_files_only:
+        return model_path
+
+    path = Path(model_path).expanduser()
+    if not path.is_dir():
+        return str(path)
+    if (path / "config.json").is_file():
+        return str(path)
+
+    snapshots = path / "snapshots"
+    if snapshots.is_dir():
+        for snapshot in sorted(snapshots.iterdir()):
+            if (snapshot / "config.json").is_file():
+                return str(snapshot)
+
+    blobs = path / "blobs"
+    if not blobs.is_dir():
+        return str(path)
+
+    config_blob = None
+    model_blob = None
+    for candidate in blobs.iterdir():
+        if not candidate.is_file():
+            continue
+        if config_blob is None:
+            try:
+                with candidate.open("r", encoding="utf-8") as handle:
+                    payload = json.load(handle)
+                if isinstance(payload, dict):
+                    config_blob = candidate
+                    continue
+            except (OSError, UnicodeDecodeError, json.JSONDecodeError):
+                pass
+        if model_blob is None or candidate.stat().st_size > model_blob.stat().st_size:
+            model_blob = candidate
+
+    if config_blob is None or model_blob is None:
+        return str(path)
+
+    digest = hashlib.sha1(str(path.resolve()).encode("utf-8")).hexdigest()[:16]
+    view = Path(tempfile.gettempdir()) / "magicvla_depthanything3_local_views" / digest
+    view.mkdir(parents=True, exist_ok=True)
+    for target, source in {
+        "config.json": config_blob,
+        "model.safetensors": model_blob,
+    }.items():
+        link = view / target
+        if link.exists() or link.is_symlink():
+            continue
+        try:
+            os.symlink(source, link)
+        except FileExistsError:
+            pass
+    return str(view)
+
+
+def _profile_sync(device):
+    if torch.cuda.is_available() and torch.device(device).type == "cuda":
+        torch.cuda.synchronize(device)
+
+
+def _profile_now(device):
+    _profile_sync(device)
+    return time.perf_counter()
 
